{
  "manifest_version": 3,
  "name": "Ourchival Clipper",
  "version": "0.1.1",
  "icons": {
    "16": "icons/cat-16.png",
    "32": "icons/cat-32.png",
    "48": "icons/cat-48.png",
    "128": "icons/cat-128.png"
  },
  "description": "Save images, X Likes, tabs, links, and source metadata to your private Ourchival vault.",
  "permissions": ["contextMenus", "activeTab", "storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-timeline-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Ourchival Clipper 0.1.1",
    "default_icon": {
      "16": "icons/cat-16.png",
      "32": "icons/cat-32.png"
    },
    "default_popup": "popup.html"
  }
}
