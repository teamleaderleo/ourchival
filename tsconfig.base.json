{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ourchival/shared": [
        "packages/shared/src/index.ts"
      ],
      "@ourchival/parsers": [
        "packages/parsers/src/index.ts"
      ],
      "@ourchival/convex/*": [
        "convex/*"
      ]
    }
  }
}
