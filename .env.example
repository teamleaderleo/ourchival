NEXT_PUBLIC_APP_URL=https://app.ourchival.com
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
VITE_CONVEX_URL=
OURCHIVAL_DEFAULT_BOARD=

# WorkOS AuthKit web environment.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate at least 32 random characters. Keep this server-only.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Convex env vars for the WorkOS owner boundary.
# Comma-separated WorkOS user IDs such as user_01H...
OURCHIVAL_ALLOWED_WORKOS_USER_IDS=
# Generate a separate long random value for 15-minute vault sessions.
OURCHIVAL_SESSION_SIGNING_SECRET=

# Optional break-glass recovery key. Keep it out of NEXT_PUBLIC_* variables.
OURCHIVAL_OWNER_ACCESS_KEY=
# Comma-separated web origins allowed to call Convex HTTP actions.
OURCHIVAL_ALLOWED_ORIGINS=http://localhost:3000,https://app.ourchival.com

# Convex env vars for Google Drive-backed originals.
# Set these with `npx convex env set KEY value`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
