NEXT_PUBLIC_APP_URL=https://app.ourchival.com
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VITE_CONVEX_URL=
OURCHIVAL_DEFAULT_BOARD=

# Convex env vars for private vault access.
# Set a long random value with:
# npx convex env set OURCHIVAL_OWNER_ACCESS_KEY <value>
OURCHIVAL_OWNER_ACCESS_KEY=
# Exact Google account allowed to unlock this single-owner vault.
OURCHIVAL_OWNER_EMAIL=
# Comma-separated web origins allowed to call Convex HTTP actions.
OURCHIVAL_ALLOWED_ORIGINS=http://localhost:3000,https://app.ourchival.com

# Convex env vars for Google Drive-backed originals.
# Set these with `npx convex env set KEY value`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
